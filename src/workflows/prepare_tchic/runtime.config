// The harness verifies these SIFs against the build's runtime.json before use.
def pythonImage = System.getenv('TCHIC_PYTHON_IMAGE')
def processorImage = System.getenv('TCHIC_PROCESSOR_IMAGE')
if (!pythonImage || !processorImage) {
  throw new IllegalArgumentException('Set TCHIC_PYTHON_IMAGE and TCHIC_PROCESSOR_IMAGE from the verified build runtime.json')
}
process {
  container = null
  containerOptions = '--env MPLCONFIGDIR=/tmp/matplotlib --env XDG_CACHE_HOME=/tmp/.cache --env NUMBA_CACHE_DIR=/tmp/numba'
  beforeScript = 'mkdir -p /tmp/matplotlib /tmp/.cache /tmp/numba'

  withName: '.*prepare_tchic_input_process' {
    container = pythonImage
  }
  withName: '.*normalize_h3k4me3_process' {
    container = pythonImage
  }
  withName: '.*normalize_gex_process' {
    container = pythonImage
  }
  withName: '.*process_dataset_process' {
    container = processorImage
  }
}
